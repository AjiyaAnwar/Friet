# FreightCore API Environment Variables Configuration
# Copy this file to .env before starting the FastAPI backend

# Database Configuration
POSTGRES_USER=freightcore
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=freightcore

# Security - CRITICAL FOR PRODUCTION
# Must be at least 32 characters long
JWT_SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
ENCRYPTION_KEY=change_this_to_a_secure_fernet_key

# CORS Settings for Frontend
# Example: http://localhost:3000,https://freightcore.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Configuration (Optional but recommended)
REDIS_URL=redis://localhost:6379/0
