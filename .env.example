# Application
APP_NAME=FreightCore
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=freightcore
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=freightcore
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://freightcore:change_me_in_production@rabbitmq:5672/

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# JWT — replace in staging/production (min 32 chars)
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for column-level PII (Fernet key, base64)
ENCRYPTION_KEY=dev-only-generate-with-cryptography-fernet-generate-key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Auth lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Rate limiting (requests per minute)
RATE_LIMIT_INTERNAL=1000
RATE_LIMIT_PORTAL=100
RATE_LIMIT_UNAUTH=20

# Idempotency TTL (seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
